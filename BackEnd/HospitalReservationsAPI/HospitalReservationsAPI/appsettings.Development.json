{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Lets /Auth/Mock/Login and /Auth/Mock/Roles issue real JWTs for any role
  // without gov.gr — dev only. This section doesn't exist in appsettings.json,
  // so MockAuth:Enabled defaults to false outside Development.
  "MockAuth": {
    "Enabled": true
  },

  "JwtSettings": {
    // Dev-only placeholder (32+ bytes, HS256's minimum key size). Move to
    // `dotnet user-secrets set JwtSettings:SigningKey "..."` instead of
    // committing a real one here.
    "SigningKey": "dev-only-insecure-signing-key-DO-NOT-USE-IN-PRODUCTION-please-change-me"
  }
}
