{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "FileLogging": {
    // Έξω από τον φάκελο δημοσίευσης (bin/publish) ώστε να μη σβήνεται σε νέο publish.
    "Path": "C:\\Logs\\HospitalReservationsAPI\\log-.txt",
    "RetainedDays": 90
  },

  "AllowedHosts": "*",

  // Real value is NOT set here on purpose — provide it via
  // `dotnet user-secrets set "ConnectionStrings:HospitalReservations" "..."`
  // (dev) or an environment variable / Key Vault (other environments).
  "ConnectionStrings": {
    "HospitalReservations": ""
  },

  "CustomSettings": {
    "DefaultDBSchema": "EPOEDbContext"
  },

  "JwtSettings": {
    "Issuer": "hospital-reservations-api",
    "Audience": "hospital-reservations-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
    // SigningKey is NOT set here on purpose — provide it via user-secrets
    // (dev) or an environment variable / Key Vault (prod). The app throws a
    // clear error on first token issuance if it's missing.
  },

  "GovGr": {
    // Placeholders — .example is a reserved, non-resolvable TLD (RFC 2606).
    // ClientId can't be left empty: ASP.NET Core's AuthenticationMiddleware
    // initializes every registered remote-auth scheme (to check its callback
    // path) on EVERY request, not just gov.gr ones — an empty ClientId fails
    // OpenIdConnectOptions.Validate() and breaks the whole API, not just login.
    // Replace all three with the real values once gov.gr registration is complete.
    "Authority": "https://TODO-configure-govgr-authority.example",
    "ClientId": "TODO-configure-govgr-client-id",
    "ClientSecret": "",
    "CallbackPath": "/signin-govgr"
  },

  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  }
}